# ─────────────────────────────────────────────────────────────────────────────
# truTRTL Voice-Agent ↔ Freshdesk Middleware — environment
# Copy to ".env" and fill in the secrets. NEVER commit the real .env.
# Values below are the REAL discovered values for the digiCART/truTRTL account
# (digicart.freshdesk.com), so most are pre-filled. Only the two secrets are blank.
# ─────────────────────────────────────────────────────────────────────────────

# --- Freshdesk (outgoing) -----------------------------------------------------
# Subdomain host only, no https://, no trailing slash. e.g. yourbrand.freshdesk.com
FRESHDESK_DOMAIN=
# API key from a Freshdesk agent's Profile Settings. Used as Basic-auth username
# with dummy password "X". KEEP SECRET.
FRESHDESK_API_KEY=

# --- Ravan (incoming) ---------------------------------------------------------
# A token YOU generate. Ravan must send it as "Authorization: Bearer <this>".
# Generate one with:  node -e "console.log('sk_trutrtl_'+require('crypto').randomBytes(24).toString('hex'))"
RAVAN_SHARED_SECRET=

# --- Complaint-number scheme --------------------------------------------------
# Confirmed: complaint number == native Freshdesk ticket ID for this account.
COMPLAINT_ID_MODE=TICKET_ID
# Only used if COMPLAINT_ID_MODE=CUSTOM_FIELD (not the case here):
COMPLAINT_ID_FIELD=

# --- Freshdesk custom-field keys (REAL keys, verified live) --------------------
CF_PLATFORM=cf_purchased_from
CF_PRODUCT=cf_custom_tags
# Brand nested chain (REQUIRED on create): brand -> product_category -> product(SKU)
CF_BRAND=cf_brand121540
CF_BRAND_VALUE=truTRTL
CF_PRODUCT_CATEGORY=cf_product_category
CF_PRODUCT_SKU=cf_product
CF_PURCHASE_DATE=cf_order_date
CF_ORDER_ID=cf_order_id
CF_PIN=cf_pin_code
CF_CITY=cf_city
CF_STATE=cf_state
CF_SERVICE_PARTNER=cf_given_to_service_partner
# Required dropdown that mirrors the group; default value below.
CF_GROUP_CUSTOM=cf_group_custom
CF_GROUP_CUSTOM_VALUE=WITH DIGICART

# Default intake queue: "with digiCART" (where current complaints land).
DEFAULT_GROUP_ID=81000089580

# The "Warranty" group — where warranty-registration tickets (type=WARRANTY) land.
# Optional: the register-warranty route defaults to this value if unset.
WARRANTY_GROUP_ID=81000089594

# --- Call-log Sheet (post-call data pipeline) ---------------------------------
# A Google Apps Script Web App URL that appends one row per call to a Sheet, so the
# QA team reviews calls without listening. Leave BLANK to disable (no-op). See
# docs/CALL_LOG_SHEET.md for the Apps Script to paste and the setup steps.
CALL_LOG_SHEET_URL=
# Optional shared secret the Apps Script checks before appending (defence-in-depth).
CALL_LOG_SHEET_SECRET=

# Temporarily log the raw Agni after-call payload shape (audit only). Leave off in prod.
LOG_RAW_WEBHOOK=

# --- Behaviour ----------------------------------------------------------------
TIMEZONE=Asia/Kolkata
COMPANY_WHATSAPP=+91 95991 11390

# --- WHAPI (proactive WhatsApp to the customer after registering) ---------------
# Get a channel + token at whapi.cloud (bind it to the truTRTL WhatsApp number so
# messages come FROM +91 95991 11390 — a message from an unknown number reads as
# spam and gets ignored, which fails the same way as not sending it).
#
# ⛔ MUST BE true IN PRODUCTION (plan item D-2). This is not optional plumbing:
# it is the message carrying the invoice + video request, and ops cannot progress
# a claim without both. Tara promises it out loud on EVERY registration.
# The failure is silent in three places at once — WHAPI_ENABLED defaults to FALSE
# (config.js), whapi.js returns { skipped: true } with NO log line, and the
# "Document-request WhatsApp sent" ticket note is written only on success. So an
# unset value looks exactly like a clean deploy while every ticket stalls.
# The retired _render-legacy/render.yaml declared none of these three — that is
# how it shipped that way on Render. Verify on the VPS: see VPS_DEPLOY.md §2.5.
WHAPI_ENABLED=false
WHAPI_TOKEN=
WHAPI_BASE_URL=https://gate.whapi.cloud
# Outbound Freshdesk HTTP timeout (ms) and retry budget.
FRESHDESK_TIMEOUT_MS=3500
FRESHDESK_MAX_RETRIES=1
# Dedup window to avoid duplicate tickets / double-logged calls (ms).
IDEMPOTENCY_WINDOW_MS=300000
# Short cache for repeated status lookups within one call (ms). Protects the 40/min limit.
STATUS_CACHE_TTL_MS=30000

# --- TEST SAFETY --------------------------------------------------------------
# When true, every registered ticket is tagged "voice_agent_test" and immediately
# Closed, so testing against the LIVE production helpdesk doesn't disturb ops.
# MUST be false in production. Set true for the first live run-through (D-3).
# ⚠ It is NOT an off-switch for registration: the ticket is still created in the
# live helpdesk and the document-request WhatsApp still goes out to the real
# number BEFORE the close runs. Test with your own mobile number.
TEST_AUTO_CLOSE=false

# --- Server -------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --- VPS deploy ---------------------------------------------------------------
# Public hostname this service answers on. docker-compose.yml interpolates it into
# the Traefik Host() rule, so it must match (a) the DNS A-record, (b) the CyberPanel
# website + cert, and (c) the <MIDDLEWARE_URL> pasted into Ravan's function configs.
# If it is unset, the container starts HEALTHY but Traefik creates no router and the
# service is unreachable — a green `docker compose ps` will not tell you.
# See VPS_DEPLOY.md.
APP_DOMAIN=trutrtl-support.digidzn.com
